# Azure AI Search service that hosts the knowledge bases
SEARCH_ENDPOINT=https://<your-search>.search.windows.net
# Preview API needed for query planning / answer synthesis / reasoning effort
SEARCH_API_VERSION=2026-05-01-preview
# Azure OpenAI / Foundry resource used for embeddings + query planning
AOAI_RESOURCE_URI=https://<your-aoai>.openai.azure.com
EMBEDDING_DEPLOYMENT=text-embedding-3-large
CHAT_DEPLOYMENT=gpt-5-mini
